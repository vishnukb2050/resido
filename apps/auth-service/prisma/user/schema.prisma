// apps/auth-service/prisma/user/schema.prisma
// User database for global identities and mobile app users
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@resido/user-client"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_WRITE_URL")
}

model User {
  id          String   @id @default(cuid())
  phone       String   @unique
  email       String?  @unique
  name        String?
  age         Int?
  description String?
  profilePhoto      String?
  profilePhotoThumb String?
  role        Role     @default(RESIDENT)
  profileName String?  @unique
  phoneVisibility VisibilityType @default(COMMUNITY)
  // Who can see this user's full profile (bio, contact, threads/flares, etc.).
  // GLOBAL allows anyone (free follow). The other three require a follow
  // request that the owner approves before granting access.
  profileVisibility ProfileVisibility @default(GLOBAL)
  // When true, the user has chosen to surface their business profile(s)
  // alongside their personal profile. Search results for the user show a
  // "Business" chip, search results for the business show the linked
  // owner card, and the public profile screen renders the owner's
  // business profiles. Restricted personal profiles still appear as
  // locked to non-allowed viewers — the link only works when the
  // viewer is allowed to see the profile in the first place.
  linkBusinessProfile Boolean @default(false)
  instagram    String?
  linkedin     String?
  website      String?
  location     String?
  isActive     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceMemberships WorkspaceMembership[]
  otpLogs              OtpLog[]
  noteFolders          NoteFolder[]
  documentFolders      DocumentFolder[]
  savedScans           SavedScan[]
  jobProfile           JobProfile?
  followers            Follow[] @relation("following")
  following            Follow[] @relation("follower")
  followRequestsSent     FollowRequest[] @relation("requester")
  followRequestsReceived FollowRequest[] @relation("target")
  incomes              PersonalIncome[]
  expenses             PersonalExpense[]
  noteShares           NoteShare[]
  documentShares       DocumentShare[]

  @@index([isActive, linkBusinessProfile])
  @@map("users")
}

enum ProfileVisibility {
  GLOBAL
  CONTACTS
  COMMUNITY
  FOLLOWERS
}

// A pending request from one user to follow another. When the target's
// profileVisibility is GLOBAL we skip this and create the Follow directly.
// On accept, a row is removed and a Follow record is created; on reject
// the row is simply removed.
model FollowRequest {
  id          String   @id @default(cuid())
  requesterId String
  targetId    String
  createdAt   DateTime @default(now())

  requester User @relation("requester", fields: [requesterId], references: [id])
  target    User @relation("target",    fields: [targetId],    references: [id])

  @@unique([requesterId, targetId])
  @@index([targetId])
  @@index([targetId, createdAt(sort: Desc)])
  @@map("follow_requests")
}

model PersonalIncome {
  id          String   @id @default(cuid())
  userId      String
  source      String
  amount      Float
  description String?
  receiptUrl  String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date(sort: Desc)])
  @@map("personal_incomes")
}

model PersonalExpense {
  id            String   @id @default(cuid())
  userId        String
  amount        Float
  category      String
  date          DateTime @default(now())
  paymentMethod String
  description   String?
  billUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date(sort: Desc)])
  @@map("personal_expenses")
}

/// Who can see this user's phone number. The mobile UI exposes three
/// options — PUBLIC, COMMUNITY, FOLLOWERS — but GROUPS and CONTACTS are
/// kept as deprecated values so existing rows continue to load (they
/// are treated as "restricted" by the API gating logic).
enum VisibilityType {
  COMMUNITY
  GROUPS
  CONTACTS
  PUBLIC
  FOLLOWERS
}

model JobProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  category    String
  subCategory String?
  description String
  pincode     String
  city        String
  district    String
  state       String
  expertise   String
  images      String[]
  isActive    Boolean  @default(true)
  
  businessName String?
  businessType String?
  experience   String?
  phone        String?
  email        String?
  website      String?
  instagram    String?
  linkedin     String?
  workingHours Json?      // Store { days, from, to }
  services     Json?      // Store array of service objects: { name, description, price, pricingType, etc }
  
  // New: Tiered Service Reach
  latitude          Float?
  longitude         Float?
  serviceAreaType   ServiceAreaType @default(PINCODE)
  serviceAreaValues String[] // List of pincodes, districts, or states
  serviceRadiusKm   Int?            @default(10) // Coverage radius from lat/lng
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([category])
  @@index([subCategory])
  @@index([pincode])
  @@index([district])
  @@index([state])
  @@index([businessName])
  @@index([isActive, category])
  @@map("job_profiles")
}

enum ServiceAreaType {
  PINCODE
  DISTRICT
  STATE
  PAN_INDIA
  GLOBAL
}


model WorkspaceMembership {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  tenantName String
  role       Role
  memberId   String
  isActive   Boolean  @default(true)
  photoUrl   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId, role])
  @@index([userId, tenantId])
  @@index([userId, isActive])
  @@index([tenantId])
  @@index([tenantId, role])
  @@map("workspace_memberships")
}

model OtpLog {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  phone     String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("otp_logs")
}

model NoteFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  pages  NotePage[]
  shares NoteShare[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("note_folders")
}

model NotePage {
  id        String   @id @default(cuid())
  folderId  String
  title     String
  content   String
  color     String?  @default("#ffffff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder NoteFolder @relation(fields: [folderId], references: [id])
  shares NoteShare[]

  @@map("note_pages")
}

model NoteShare {
  id         String    @id @default(cuid())
  userId     String    // Owner
  folderId   String?
  pageId     String?
  targetType ShareTarget // COMMUNITY, GROUP, CONTACT
  targetId   String    // tenantId, groupId, or memberId
  createdAt  DateTime  @default(now())

  folder NoteFolder? @relation(fields: [folderId], references: [id])
  page   NotePage?   @relation(fields: [pageId], references: [id])
  user   User        @relation(fields: [userId], references: [id])

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([folderId, targetType, targetId])
  @@index([pageId, targetType, targetId])
  @@map("note_shares")
}

model SavedScan {
  id        String   @id @default(cuid())
  userId    String
  data      String
  type      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_scans")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

model DocumentFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String?  @default("#6366f1")
  icon      String?  @default("folder")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  files  DocumentFile[]
  shares DocumentShare[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("document_folders")
}

model DocumentFile {
  id          String   @id @default(cuid())
  folderId    String
  name        String   // Original file name (used for download)
  title       String?  // User-supplied title (preferred display name)
  description String?  // Optional notes about the document
  url         String
  type        String   // IMAGE, PDF, DOC, etc.
  size        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folder DocumentFolder @relation(fields: [folderId], references: [id])
  shares DocumentShare[]

  @@map("document_files")
}

model DocumentShare {
  id         String    @id @default(cuid())
  userId     String    // Owner
  folderId   String?
  fileId     String?
  targetType ShareTarget
  targetId   String    // tenantId, groupId, or memberId
  createdAt  DateTime  @default(now())

  folder DocumentFolder? @relation(fields: [folderId], references: [id])
  file   DocumentFile?   @relation(fields: [fileId], references: [id])
  user   User            @relation(fields: [userId], references: [id])

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([folderId, targetType, targetId])
  @@index([fileId, targetType, targetId])
  @@map("document_shares")
}

enum ShareTarget {
  COMMUNITY
  GROUP
  CONTACT
}

enum Role {
  SUPER_ADMIN
  APARTMENT_ADMIN
  RESIDENT
  CLEANING_STAFF
  CARETAKER
  SECURITY_STAFF
  ACCOUNTS_STAFF
  MAINTENANCE_STAFF
  ADMIN_STAFF
  STAFF
  SERVICE_STAFF
  MANAGER_STAFF
  MEMBER
}
