// apps/auth-service/prisma/user/schema.prisma
// User database for global identities and mobile app users
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@resido/user-client"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_WRITE_URL")
}

model User {
  id          String   @id @default(cuid())
  phone       String   @unique
  email       String?  @unique
  name        String?
  age         Int?
  description String?
  profilePhoto String?
  role        Role     @default(RESIDENT)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceMemberships WorkspaceMembership[]
  otpLogs              OtpLog[]
  noteFolders          NoteFolder[]
  jobProfile           JobProfile?

  @@map("users")
}

model JobProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  category    String
  description String
  pincode     String
  city        String
  district    String
  state       String
  expertise   String
  images      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("job_profiles")
}

model WorkspaceMembership {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  tenantName String
  role       Role
  memberId   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, tenantId])
  @@map("workspace_memberships")
}

model OtpLog {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  phone     String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("otp_logs")
}

model NoteFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  pages  NotePage[]
  shares NoteShare[]

  @@map("note_folders")
}

model NotePage {
  id        String   @id @default(cuid())
  folderId  String
  title     String
  content   String
  color     String?  @default("#ffffff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder NoteFolder @relation(fields: [folderId], references: [id])
  shares NoteShare[]

  @@map("note_pages")
}

model NoteShare {
  id         String    @id @default(cuid())
  userId     String    // Owner
  folderId   String?
  pageId     String?
  targetType ShareTarget // COMMUNITY, GROUP, CONTACT
  targetId   String    // tenantId, groupId, or memberId
  createdAt  DateTime  @default(now())

  folder NoteFolder? @relation(fields: [folderId], references: [id])
  page   NotePage?   @relation(fields: [pageId], references: [id])

  @@map("note_shares")
}

enum ShareTarget {
  COMMUNITY
  GROUP
  CONTACT
}

enum Role {
  SUPER_ADMIN
  APARTMENT_ADMIN
  RESIDENT
  CLEANING_STAFF
  CARETAKER
  SECURITY_STAFF
  ACCOUNTS_STAFF
  MAINTENANCE_STAFF
  ADMIN_STAFF
  STAFF
  SERVICE_STAFF
}
