generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@resido/flaredthread-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_WRITE_URL")
}

model Blog {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String
  authorId    String   // Global User ID
  authorName  String?
  authorAvatar String?
  location    String?
  isVerified  Boolean  @default(false)
  category    String?
  type        BlogType @default(THREAD)
  mediaUrls   String[]
  mediaType   BlogMediaType @default(IMAGE)
  musicName   String?  @default("Original Audio")
  musicId     String?  // Optional reference to a music track
  tags        String[] // Array of Global User IDs
  hashtags    String[] // Array of hashtags (without #)
  visibility  BlogVisibility @default(PUBLIC)
  targetCommunities String[] // Tenant IDs for COMMUNITY visibility
  audioUrl    String?  // URL to custom background audio
  commentsEnabled Boolean @default(true)

  // Optional pin to the author's business profile. When set, the post also
  // appears on that business's public detail page so prospective customers
  // can see the owner's recent work.
  businessProfileId String?
  
  // Interaction Counts
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  resharesCount Int @default(0)
  savesCount    Int @default(0)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId    String?
  pollId      String?
  poll        BlogPoll? @relation(fields: [pollId, tenantId], references: [id, tenantId])

  comments    BlogComment[]
  interactions BlogInteraction[]
  mediaAssets  MediaAsset[]

  mediaStatus   MediaProcessingStatus @default(READY)
  mediaAssetIds String[]              @default([])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([businessProfileId])
  @@index([tenantId, mediaStatus])
  @@index([tenantId, isActive, type, visibility, createdAt(sort: Desc), id(sort: Desc)])
  @@index([isActive, visibility, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, isActive, createdAt(sort: Desc), id(sort: Desc)])
  @@index([businessProfileId, isActive, createdAt(sort: Desc), id(sort: Desc)])
  @@index([parentId, authorId, tenantId])
  @@map("blogs")
}

model MediaAsset {
  id               String                @id @default(cuid())
  tenantId         String
  ownerUserId      String
  blogId           String?
  blog             Blog?                 @relation(fields: [blogId, tenantId], references: [id, tenantId])
  kind             MediaKind
  sourceKey        String
  status           MediaProcessingStatus @default(PENDING)
  errorMessage     String?
  durationSec      Float?
  width            Int?
  height           Int?
  thumbnailKey     String?
  posterKey        String?
  hlsManifestKey   String?
  dashManifestKey  String?
  renditions       Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([blogId, tenantId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("media_assets")
}

model BlogPoll {
  id          String   @id @default(cuid())
  tenantId    String   @default("global")
  question    String
  options     BlogPollOption[]
  votes       BlogPollVote[]
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  blogs       Blog[]
  comments    BlogComment[]

  @@unique([id, tenantId])
  @@map("blog_polls")
}

model BlogPollOption {
  id          String   @id @default(cuid())
  pollId      String
  tenantId    String   @default("global")
  poll        BlogPoll @relation(fields: [pollId, tenantId], references: [id, tenantId])
  text        String
  votes       BlogPollVote[]

  @@unique([id, tenantId])
  @@map("blog_poll_options")
}

model BlogPollVote {
  id          String   @id @default(cuid())
  pollId      String
  optionId    String
  userId      String
  tenantId    String   @default("global")
  
  poll        BlogPoll       @relation(fields: [pollId, tenantId], references: [id, tenantId])
  option      BlogPollOption @relation(fields: [optionId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([pollId, userId, tenantId])
  @@map("blog_poll_votes")
}

model BlogComment {
  id        String   @id @default(cuid())
  tenantId  String   @default("global")
  blogId    String
  blog      Blog     @relation(fields: [blogId, tenantId], references: [id, tenantId])
  userId    String
  userName  String
  userAvatar String?
  content   String
  likesCount Int     @default(0)
  pollId    String?
  poll      BlogPoll? @relation(fields: [pollId, tenantId], references: [id, tenantId])
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@index([blogId, tenantId])
  @@index([tenantId])
  @@index([blogId, tenantId, createdAt(sort: Desc)])
  @@map("blog_comments")
}

model BlogInteraction {
  id        String   @id @default(cuid())
  tenantId  String   @default("global")
  blogId    String
  blog      Blog     @relation(fields: [blogId, tenantId], references: [id, tenantId])
  userId    String
  type      BlogInteractionType
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@unique([blogId, userId, type, tenantId])
  @@index([tenantId])
  @@index([userId, type, tenantId, createdAt(sort: Desc)])
  @@map("blog_interactions")
}

enum BlogInteractionType {
  LIKE
  RESHARE
  SAVE
}

enum BlogType {
  THREAD
  FLARE
}

enum BlogMediaType {
  IMAGE
  VIDEO
}

enum BlogVisibility {
    PUBLIC
    CONTACTS
    FOLLOWERS
}

enum MediaProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MediaKind {
  VIDEO
  IMAGE
}
