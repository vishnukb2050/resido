generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_WRITE_URL")
}

model Blog {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String
  authorId    String   // Global User ID
  category    String?
  type        BlogType @default(THREAD)
  mediaUrls   String[]
  mediaType   BlogMediaType @default(IMAGE)
  tags        String[] // Array of Global User IDs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("blogs")
}

enum BlogType {
  THREAD
  FLARE
}

enum BlogMediaType {
  IMAGE
  VIDEO
}
