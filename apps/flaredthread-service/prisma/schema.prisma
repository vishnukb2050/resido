generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@resido/flaredthread-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_WRITE_URL")
}

model Blog {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String
  authorId    String   // Global User ID
  authorName  String?
  authorAvatar String?
  location    String?
  isVerified  Boolean  @default(false)
  category    String?
  type        BlogType @default(THREAD)
  mediaUrls   String[]
  mediaType   BlogMediaType @default(IMAGE)
  musicName   String?  @default("Original Audio")
  musicId     String?  // Optional reference to a music track
  tags        String[] // Array of Global User IDs
  hashtags    String[] // Array of hashtags (without #)
  visibility  BlogVisibility @default(PUBLIC)
  targetCommunities String[] // Tenant IDs for COMMUNITY visibility
  audioUrl    String?  // URL to custom background audio
  commentsEnabled Boolean @default(true)
  
  // Interaction Counts
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  resharesCount Int @default(0)
  savesCount    Int @default(0)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pollId      String?
  poll        Poll? @relation(fields: [pollId, tenantId], references: [id, tenantId])

  comments    Comment[]
  interactions Interaction[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("blogs")
}

model Poll {
  id          String   @id @default(cuid())
  tenantId    String   @default("global")
  question    String
  options     PollOption[]
  votes       PollVote[]
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  blogs       Blog[]

  @@unique([id, tenantId])
  @@map("polls")
}

model PollOption {
  id          String   @id @default(cuid())
  pollId      String
  tenantId    String   @default("global")
  poll        Poll     @relation(fields: [pollId, tenantId], references: [id, tenantId])
  text        String
  votes       PollVote[]

  @@unique([id, tenantId])
  @@map("poll_options")
}

model PollVote {
  id          String   @id @default(cuid())
  pollId      String
  optionId    String
  userId      String
  tenantId    String   @default("global")
  
  poll        Poll       @relation(fields: [pollId, tenantId], references: [id, tenantId])
  option      PollOption @relation(fields: [optionId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([pollId, userId, tenantId])
  @@map("poll_votes")
}

model Comment {
  id        String   @id @default(cuid())
  tenantId  String   @default("global")
  blogId    String
  blog      Blog     @relation(fields: [blogId, tenantId], references: [id, tenantId])
  userId    String
  userName  String
  userAvatar String?
  content   String
  likesCount Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@index([blogId, tenantId])
  @@index([tenantId])
  @@map("blog_comments")
}

model Interaction {
  id        String   @id @default(cuid())
  tenantId  String   @default("global")
  blogId    String
  blog      Blog     @relation(fields: [blogId, tenantId], references: [id, tenantId])
  userId    String
  type      InteractionType
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@unique([blogId, userId, type, tenantId])
  @@index([tenantId])
  @@map("blog_interactions")
}

enum InteractionType {
  LIKE
  RESHARE
  SAVE
}

enum BlogType {
  THREAD
  FLARE
}

enum BlogMediaType {
  IMAGE
  VIDEO
}

enum BlogVisibility {
    PUBLIC
    CONTACTS
    FOLLOWERS
}
