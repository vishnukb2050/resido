generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_WRITE_URL")
}

model Blog {
  id          String   @id @default(cuid())
  tenantId    String   @index
  title       String
  content     String
  authorId    String   // Member ID
  category    String?
  mediaUrls   String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blogs")
}
