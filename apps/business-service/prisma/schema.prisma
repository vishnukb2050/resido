generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@resido/business-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_WRITE_URL")
}

model BusinessProfile {
  id              String   @id @default(cuid())
  userId          String   // Global user ID
  tenantId        String?  // Linked community (optional)
  profileType     String   @default("BUSINESS") // BUSINESS or JOB
  businessName    String
  category        String
  subcategory     String?
  businessType    String   @default("INDIVIDUAL") // INDIVIDUAL or COMPANY
  about           String
  logo            String?  // S3 Key for Logo
  experience      String?
  
  // Contact Info
  phone           String?
  email           String?
  website         String?
  workingHours    Json?
  
  // Social Links
  instagram       String?
  linkedin        String?
  hashtags        String?  // Comma-separated hashtags or space-separated

  // Location

  location        String?  // block/unit
  area            String?  // city/area
  fullAddress     String?
  latitude        Float?
  longitude       Float?
  serviceAreaType   String?  @default("PINCODE") // PINCODE, DISTRICT, STATE, PAN_INDIA
  serviceAreaValues String[] // List of pincodes, districts, or states
  serviceRadiusKm   Int?     @default(10) // Coverage radius from lat/lng

  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  // Total customer-side profile views (incremented on getProfile when a
  // non-owner opens the business detail screen).
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services        ServiceItem[]
  slots           BusinessSlot[]

  @@index([userId])
  @@index([tenantId])
  @@index([category])
  @@index([userId, isActive, createdAt(sort: Desc)])
  @@index([tenantId, isActive])
  @@index([isActive, serviceAreaType])
  @@map("business_profiles")
}

model ServiceItem {
  id                String          @id @default(cuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
  name              String
  description       String?
  pricingType       String          @default("FIXED") // FIXED, STARTING, CONTACT
  price             Float?
  responseTime      String?
  isEmergency       Boolean         @default(false)

  @@index([businessProfileId])
  @@map("business_services")
}

// ─── Business Slot Booking ────────────────────────────────────────────────────
model BusinessSlot {
  id                     String   @id @default(cuid())
  businessProfileId      String
  businessProfile        BusinessProfile @relation(fields: [businessProfileId], references: [id])
  name                   String   // e.g. "Consultation", "Home Visit"
  description            String?
  maxPersons             Int      @default(1)
  timeSlots              String[] // e.g. ["09:00-10:00", "10:00-11:00"]
  availableDates         String[] // e.g. ["2024-10-01"]
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Dynamic scheduling (same as Amenity)
  scheduleType           String   @default("CUSTOM") // "WEEKLY", "MONTHLY", "CUSTOM"
  scheduleConfig         String?  // JSON serialized config
  allowRecurringBookings Boolean  @default(false)

  // How far in advance (in weeks) customers may pick a date when booking
  // this slot. Owners typically set 1–12 weeks. Defaults to 4 weeks so
  // existing slots keep showing roughly a month of dates.
  advanceBookingWeeks    Int      @default(4)

  bookings               BusinessBooking[]

  @@index([businessProfileId])
  @@index([businessProfileId, isActive])
  @@map("business_slots")
}

model BusinessBooking {
  id                String   @id @default(cuid())
  businessProfileId String
  slotId            String
  userId            String   // Global user ID (public, not just residents)
  userName          String?
  userPhone         String?
  bookingDate       String   // YYYY-MM-DD
  timeSlot          String
  persons           Int      @default(1)
  status            String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  notes             String?
  createdAt         DateTime @default(now())

  // Per-profile per-day sequential token (e.g. 1, 2, 3...). Displayed to
  // the customer as a zero-padded number ("0001") in the app.
  tokenNumber       Int?

  // Recurrence (same as AmenityBooking)
  isRecurring       Boolean  @default(false)
  recurringPeriod   String?  // "WEEKLY", "MONTHLY"
  parentBookingId   String?

  slot              BusinessSlot @relation(fields: [slotId], references: [id])
  updates           BusinessBookingUpdate[]

  @@index([businessProfileId])
  @@index([slotId])
  @@index([userId])
  @@index([businessProfileId, bookingDate])
  @@index([businessProfileId, slotId, bookingDate, timeSlot, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([businessProfileId, bookingDate, tokenNumber])
  @@map("business_bookings")
}

// Free-form status update or photo a business owner posts on a booking
// so the customer can see progress notes (e.g. "Your order is being
// prepared", "Technician on the way") with optional media.
model BusinessBookingUpdate {
  id           String   @id @default(cuid())
  bookingId    String
  message      String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  authorUserId String

  booking      BusinessBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("business_booking_updates")
}
