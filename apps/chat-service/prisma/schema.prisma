// chat-service Prisma schema.
// Single shared `resido_chat` database for ALL communities. Rows are isolated
// by `tenantId` (the community/client id), matching the rest of the platform
// (resido_core uses the same tenantId model). No database-per-community.
generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@resido/chat-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CHAT_WRITE_URL")
}

model Conversation {
  id        String               @id @default(cuid())
  tenantId  String
  type      ConversationType     @default(DIRECT)
  name      String?              // For group chats
  groupId   String?              // Link to resident-service group
  createdAt DateTime             @default(now())

  members   ConversationMember[]
  messages  Message[]

  @@index([tenantId])
  @@index([tenantId, groupId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  memberId       String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, memberId])
  @@index([tenantId, memberId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  tenantId       String
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String?
  mediaUrl       String?      // S3 key
  pollId         String?      // Reference to a poll
  poll           Poll?        @relation(fields: [pollId], references: [id])
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@index([tenantId, conversationId, isDeleted, createdAt])
  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

model Poll {
  id          String   @id @default(cuid())
  tenantId    String
  question    String
  options     PollOption[]
  votes       PollVote[]
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  messages    Message[]

  @@index([tenantId])
  @@map("polls")
}

model PollOption {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id])
  text        String
  votes       PollVote[]

  @@map("poll_options")
}

model PollVote {
  id          String   @id @default(cuid())
  tenantId    String
  pollId      String
  optionId    String
  userId      String

  poll        Poll       @relation(fields: [pollId], references: [id])
  option      PollOption @relation(fields: [optionId], references: [id])

  @@unique([pollId, userId])
  @@index([tenantId])
  @@map("poll_votes")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  AUDIO
  POLL
}
