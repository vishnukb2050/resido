// resident-service Prisma schema (Shared Master Core DB)
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@resido/resident-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_WRITE_URL")
}

// ─── Apartment / Building ─────────────────────────────────────────────────────
model Apartment {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  address   String
  city      String
  state     String
  pincode   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  blocks    Block[]

  @@index([tenantId])
  @@map("apartments")
}

model Block {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])
  units       Unit[]

  @@index([tenantId])
  @@map("blocks")
}

model Unit {
  id       String  @id @default(cuid())
  tenantId String
  number   String
  floor    Int
  blockId  String
  block    Block   @relation(fields: [blockId], references: [id])
  families Family[]

  superBuiltUpArea Float @default(0) // Size in sq. ft. for area-based billing
  maintenanceBills MaintenanceBill[]
  paymentSplitShares PaymentSplitShare[]

  @@index([tenantId])
  @@map("units")
}

// ─── Department ───────────────────────────────────────────────────────────────
model Department {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  type      DepartmentType
  createdAt DateTime         @default(now())

  members DepartmentMember[]

  @@index([tenantId])
  @@map("departments")
}

model DepartmentMember {
  id           String     @id @default(cuid())
  tenantId     String
  departmentId String
  memberId     String
  department   Department @relation(fields: [departmentId], references: [id])
  member       Member     @relation(fields: [memberId], references: [id])
  assignedAt   DateTime   @default(now())

  @@index([tenantId])
  @@unique([departmentId, memberId])
  @@map("department_members")
}

// ─── Family & Members ─────────────────────────────────────────────────────────
model Family {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id])
  members   Member[]
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("families")
}

model Member {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?  // Global user ID from auth-service
  name         String
  phone        String   
  email        String?
  role         MemberRole @default(RESIDENT)
  profilePhoto String?  // S3 key
  profileName  String?
  phoneVisibility String @default("COMMUNITY")
  isActive     Boolean  @default(true)
  occupancyType OccupancyType @default(RESIDENT)
  address       String?
  tenantName    String?
  tenantPhone   String?
  familyId     String?
  instagram    String?
  linkedin     String?
  website      String?
  location     String?
  family       Family?  @relation(fields: [familyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  departmentMemberships DepartmentMember[]
  pollVotes             PollVote[]
  groupMemberships      GroupMember[]
  notifications         Notification[]
  complaints            Complaint[]
  visitors              Visitor[]
  ownedFolders          DocFolder[]    @relation("OwnedFolders")
  ownedFiles            DocFile[]      @relation("OwnedFiles")
  docPermissions        DocPermission[]
  ownedNoteFolders      NoteFolder[]   @relation("OwnedNoteFolders")
  ownedNotes            Note[]         @relation("OwnedNotes")
  notePermissions       NotePermission[]
  financeTransactions   FinanceTransaction[]
  financeBudgets        FinanceBudget[]
  amenityBookings       AmenityBooking[]

  @@index([tenantId])
  @@unique([tenantId, phone])
  @@map("members")
}

// ─── Notice Board ─────────────────────────────────────────────────────────────
model Notice {
  id              String   @id @default(cuid())
  tenantId        String
  title           String
  body            String
  postedBy        String   // member id
  photoUrl        String?
  sendWhatsApp    Boolean  @default(false)
  whatsAppSentAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@map("notices")
}

// ─── Community Polls ──────────────────────────────────────────────────────────
model Poll {
  id          String       @id @default(cuid())
  tenantId    String
  question    String
  createdBy   String
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  options     PollOption[]

  @@index([tenantId])
  @@map("polls")
}

model PollOption {
  id       String     @id @default(cuid())
  tenantId String
  pollId   String
  text     String
  poll     Poll       @relation(fields: [pollId], references: [id])
  votes    PollVote[]

  @@index([tenantId])
  @@map("poll_options")
}

model PollVote {
  id       String     @id @default(cuid())
  tenantId String
  optionId String
  memberId String
  option   PollOption @relation(fields: [optionId], references: [id])
  member   Member     @relation(fields: [memberId], references: [id])
  votedAt  DateTime   @default(now())

  @@index([tenantId])
  @@unique([optionId, memberId])
  @@map("poll_votes")
}

// ─── Groups ───────────────────────────────────────────────────────────────────
model Group {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  createdBy String
  createdAt DateTime      @default(now())

  members         GroupMember[]
  docPermissions  DocPermission[]
  notePermissions NotePermission[]

  @@index([tenantId])
  @@map("groups")
}

model GroupMember {
  id       String @id @default(cuid())
  tenantId String
  groupId  String
  memberId String
  group    Group  @relation(fields: [groupId], references: [id])
  member   Member @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@unique([groupId, memberId])
  @@map("group_members")
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  memberId  String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@map("notifications")
}

// ─── Complaints ───────────────────────────────────────────────
model Complaint {
  id            String         @id @default(cuid())
  tenantId      String?
  title         String
  description   String
  status        ComplaintStatus @default(OPEN)
  priority      Priority       @default(MEDIUM)
  memberId      String?
  member        Member?        @relation(fields: [memberId], references: [id])
  category      String?
  assignedTo    String?        // memberId of staff
  mediaUrls     String[]
  progressNotes Json?        // Array of progress updates [{ id, message, photos: [], updatedBy, createdAt, status }]
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@map("complaints")
}

// ─── Visitors / Gatepass ──────────────────────────────────────
model Visitor {
  id            String       @id @default(cuid())
  tenantId      String
  name          String
  phone         String
  purpose       String?
  category      String?
  description   String?
  personsCount  Int          @default(1)
  unitToVisit   String?
  entryTime     DateTime?
  exitTime      DateTime?
  passCode      String       
  status        VisitorStatus @default(PENDING)
  memberId      String       // The resident being visited
  member        Member       @relation(fields: [memberId], references: [id])
  vehicleNumber String?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@unique([tenantId, passCode])
  @@map("visitors")
}

// ─── Events / Calendar ────────────────────────────────────────
model Event {
  id            String         @id @default(cuid())
  tenantId      String
  title         String
  description   String?
  location      String?
  startDate     DateTime
  endDate       DateTime
  visibility    EventVisibility @default(COMMUNITY)
  sharedWithIds String[]     // IDs of members/groups if not COMMUNITY/PRIVATE
  audience      String[]       @default([])
  hasAlert      Boolean        @default(false)
  alertTime     DateTime?
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@map("events")
}

enum EventVisibility {
  COMMUNITY
  CONTACTS
  GROUPS
  PRIVATE
}

// ─── Gallery ──────────────────────────────────────────────────
model GalleryFolder {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       Gallery[]

  @@index([tenantId])
  @@map("gallery_folders")
}

model Gallery {
  id          String   @id @default(cuid())
  tenantId    String
  folderId    String?
  folder      GalleryFolder? @relation(fields: [folderId], references: [id])
  title       String
  description String?
  mediaUrls   String[]
  type        MediaType @default(IMAGE)
  category    String?  // e.g. "Club House", "Garden", "Events"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("gallery")
}

enum MediaType {
  IMAGE
  VIDEO
}

// ─── Document Management ──────────────────────────────────────
model DocFolder {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String   @default("#6366f1")
  ownerId     String   // memberId
  owner       Member   @relation("OwnedFolders", fields: [ownerId], references: [id])
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files       DocFile[]
  permissions DocPermission[]

  @@index([tenantId, ownerId])
  @@map("doc_folders")
}

model DocFile {
  id          String   @id @default(cuid())
  tenantId    String
  folderId    String?
  folder      DocFolder? @relation(fields: [folderId], references: [id])
  name        String
  description String?
  fileUrl     String   // S3 URL
  fileType    String   // PDF, WORD, EXCEL, etc.
  fileSize    String
  ownerId     String   // memberId
  owner       Member   @relation("OwnedFiles", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions DocPermission[]

  @@index([tenantId, ownerId])
  @@map("doc_files")
}

model DocPermission {
  id          String   @id @default(cuid())
  tenantId    String
  fileId      String?
  file        DocFile? @relation(fields: [fileId], references: [id])
  folderId    String?
  folder      DocFolder? @relation(fields: [folderId], references: [id])
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  accessLevel AccessLevel @default(VIEWER)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("doc_permissions")
}

enum AccessLevel {
  OWNER
  EDITOR
  VIEWER
}

// ─── Note Management ──────────────────────────────────────────
model NoteFolder {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String   @default("#6366f1")
  ownerId     String   // memberId
  owner       Member   @relation("OwnedNoteFolders", fields: [ownerId], references: [id])
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes       Note[]
  permissions NotePermission[]

  @@index([tenantId, ownerId])
  @@map("note_folders")
}

model Note {
  id          String   @id @default(cuid())
  tenantId    String
  folderId    String?
  folder      NoteFolder? @relation(fields: [folderId], references: [id])
  title       String
  body        String   @db.Text
  bgColor     String   @default("#ffffff")
  isPinned    Boolean  @default(false)
  ownerId     String   // memberId
  owner       Member   @relation("OwnedNotes", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions NotePermission[]

  @@index([tenantId, ownerId])
  @@map("notes")
}

model NotePermission {
  id          String   @id @default(cuid())
  tenantId    String
  noteId      String?
  note        Note?    @relation(fields: [noteId], references: [id])
  folderId    String?
  folder      NoteFolder? @relation(fields: [folderId], references: [id])
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  accessLevel AccessLevel @default(VIEWER)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("note_permissions")
}

// ─── Finance Management ───────────────────────────────────────
model FinanceTransaction {
  id            String          @id @default(cuid())
  tenantId      String
  memberId      String
  member        Member          @relation(fields: [memberId], references: [id])
  amount        Float
  type          TransactionType @default(EXPENSE)
  categoryId    String
  category      FinanceCategory @relation(fields: [categoryId], references: [id])
  date          DateTime        @default(now())
  paymentMethod String          @default("CASH") // UPI, CARD, CASH
  description   String?
  billUrl       String?         // S3 URL
  tags          String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, memberId])
  @@map("finance_transactions")
}

model FinanceCategory {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  icon      String?
  color     String?
  type      TransactionType @default(EXPENSE)
  createdAt DateTime        @default(now())

  transactions FinanceTransaction[]
  budgets      FinanceBudget[]

  @@index([tenantId])
  @@map("finance_categories")
}

model FinanceBudget {
  id         String          @id @default(cuid())
  tenantId   String
  memberId   String
  member     Member          @relation(fields: [memberId], references: [id])
  categoryId String
  category   FinanceCategory @relation(fields: [categoryId], references: [id])
  amount     Float           // Budget limit
  month      Int             // 1-12
  year       Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tenantId, memberId])
  @@unique([memberId, categoryId, month, year])
  @@map("finance_budgets")
}

enum TransactionType {
  INCOME
  EXPENSE
}

// ─── Blogs / Flares / Threads ─────────────────────────────────
model Blog {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  content     String
  authorId    String   // Global User ID
  authorName  String?
  authorAvatar String?
  location    String?
  isVerified  Boolean  @default(false)
  category    String?
  type        BlogType @default(THREAD)
  mediaUrls   String[]
  mediaType   BlogMediaType @default(IMAGE)
  musicName   String?  @default("Original Audio")
  musicId     String?  // Optional reference to a music track
  tags        String[] // Array of Global User IDs
  hashtags    String[] // Array of hashtags (without #)
  visibility  BlogVisibility @default(PUBLIC)
  targetCommunities String[] // Tenant IDs for COMMUNITY visibility
  audioUrl    String?  // URL to custom background audio
  commentsEnabled Boolean @default(true)

  // Optional pin to the author's business profile (flares/threads).
  businessProfileId String?

  // Interaction Counts
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  resharesCount Int @default(0)
  savesCount    Int @default(0)

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId    String?
  pollId      String?
  poll        BlogPoll? @relation(fields: [pollId, tenantId], references: [id, tenantId])

  comments    BlogComment[]
  interactions BlogInteraction[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([businessProfileId])
  @@map("blogs")
}

model BlogPoll {
  id          String   @id @default(cuid())
  tenantId    String   @default("global")
  question    String
  options     BlogPollOption[]
  votes       BlogPollVote[]
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  blogs       Blog[]
  comments    BlogComment[]

  @@unique([id, tenantId])
  @@map("blog_polls")
}

model BlogPollOption {
  id          String   @id @default(cuid())
  pollId      String
  tenantId    String   @default("global")
  poll        BlogPoll @relation(fields: [pollId, tenantId], references: [id, tenantId])
  text        String
  votes       BlogPollVote[]

  @@unique([id, tenantId])
  @@map("blog_poll_options")
}

model BlogPollVote {
  id          String   @id @default(cuid())
  pollId      String
  optionId    String
  userId      String
  tenantId    String   @default("global")
  
  poll        BlogPoll       @relation(fields: [pollId, tenantId], references: [id, tenantId])
  option      BlogPollOption @relation(fields: [optionId, tenantId], references: [id, tenantId])

  @@unique([id, tenantId])
  @@unique([pollId, userId, tenantId])
  @@map("blog_poll_votes")
}

model BlogComment {
  id        String   @id @default(cuid())
  tenantId  String   @default("global")
  blogId    String
  blog      Blog     @relation(fields: [blogId, tenantId], references: [id, tenantId])
  userId    String
  userName  String
  userAvatar String?
  content   String
  likesCount Int     @default(0)
  pollId    String?
  poll      BlogPoll? @relation(fields: [pollId, tenantId], references: [id, tenantId])
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@index([blogId, tenantId])
  @@index([tenantId])
  @@map("blog_comments")
}

model BlogInteraction {
  id        String   @id @default(cuid())
  tenantId  String   @default("global")
  blogId    String
  blog      Blog     @relation(fields: [blogId, tenantId], references: [id, tenantId])
  userId    String
  type      BlogInteractionType
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@unique([blogId, userId, type, tenantId])
  @@index([tenantId])
  @@map("blog_interactions")
}

enum BlogInteractionType {
  LIKE
  RESHARE
  SAVE
}

enum BlogType {
  THREAD
  FLARE
}

enum BlogMediaType {
  IMAGE
  VIDEO
}

enum BlogVisibility {
    PUBLIC
    CONTACTS
    FOLLOWERS
}

// ─── Business Profiles ────────────────────────────────────────
model BusinessProfile {
  id              String   @id @default(cuid())
  userId          String   // Global user ID
  tenantId        String?  // Linked community (optional)
  profileType     String   @default("BUSINESS") // BUSINESS or JOB
  businessName    String
  category        String
  subcategory     String?
  businessType    String   @default("INDIVIDUAL") // INDIVIDUAL or COMPANY
  about           String
  logo            String?  // S3 Key for Logo
  experience      String?
  
  // Contact Info
  phone           String?
  email           String?
  website         String?
  workingHours    Json?
  
  // Social Links
  instagram       String?
  linkedin        String?
  hashtags        String?  // Comma-separated hashtags or space-separated

  // Location
  location        String?  // block/unit
  area            String?  // city/area
  fullAddress     String?
  latitude        Float?
  longitude       Float?
  serviceAreaType   String?  @default("PINCODE") // PINCODE, DISTRICT, STATE, PAN_INDIA
  serviceAreaValues String[] // List of pincodes, districts, or states
  serviceRadiusKm   Int?     @default(10) // Coverage radius from lat/lng

  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  services        ServiceItem[]
  slots           BusinessSlot[]

  @@index([userId])
  @@index([tenantId])
  @@index([category])
  @@map("business_profiles")
}

model ServiceItem {
  id                String          @id @default(cuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id])
  name              String
  description       String?
  pricingType       String          @default("FIXED") // FIXED, STARTING, CONTACT
  price             Float?
  responseTime      String?
  isEmergency       Boolean         @default(false)
  
  @@map("business_services")
}

// ─── Business Slot Booking ────────────────────────────────────────────────────
model BusinessSlot {
  id                     String   @id @default(cuid())
  businessProfileId      String
  businessProfile        BusinessProfile @relation(fields: [businessProfileId], references: [id])
  name                   String   // e.g. "Consultation", "Home Visit"
  description            String?
  maxPersons             Int      @default(1)
  timeSlots              String[] // e.g. ["09:00-10:00", "10:00-11:00"]
  availableDates         String[] // e.g. ["2024-10-01"]
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Dynamic scheduling (same as Amenity)
  scheduleType           String   @default("CUSTOM") // "WEEKLY", "MONTHLY", "CUSTOM"
  scheduleConfig         String?  // JSON serialized config
  allowRecurringBookings Boolean  @default(false)

  // Window (in weeks) within which customers may pick a date. Default 4 weeks.
  advanceBookingWeeks    Int      @default(4)

  bookings               BusinessBooking[]

  @@index([businessProfileId])
  @@map("business_slots")
}

model BusinessBooking {
  id                String   @id @default(cuid())
  businessProfileId String
  slotId            String
  userId            String   // Global user ID (public, not just residents)
  userName          String?
  userPhone         String?
  bookingDate       String   // YYYY-MM-DD
  timeSlot          String
  persons           Int      @default(1)
  status            String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  notes             String?
  createdAt         DateTime @default(now())

  // Per-profile per-day sequential token (e.g. 1 → "0001").
  tokenNumber       Int?

  // Recurrence (same as AmenityBooking)
  isRecurring       Boolean  @default(false)
  recurringPeriod   String?  // "WEEKLY", "MONTHLY"
  parentBookingId   String?

  slot              BusinessSlot @relation(fields: [slotId], references: [id])
  updates           BusinessBookingUpdate[]

  @@index([businessProfileId])
  @@index([slotId])
  @@index([userId])
  @@index([businessProfileId, bookingDate])
  @@map("business_bookings")
}

model BusinessBookingUpdate {
  id           String   @id @default(cuid())
  bookingId    String
  message      String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  authorUserId String

  booking      BusinessBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("business_booking_updates")
}

// ─── Visitors (Entry/Exit) ────────────────────────────────────
model VisitorEntry {
  id          String    @id @default(cuid())
  visitorName String
  phone       String?
  purpose     String?
  unitToVisit String
  category    String?   // Visitor, Delivery, Maintenance & Repair
  description String?
  vehicleNumber String?
  photoUrl    String?   // S3 key
  inTime      DateTime  @default(now())
  outTime     DateTime?
  loggedBy    String    // security member id
  gatepassId  String?   // Link to gatepass if used
  createdAt   DateTime  @default(now())

  @@map("visitor_entries")
}

model Gatepass {
  id              String   @id @default(cuid())
  visitorName     String
  phone           String?
  personsCount    Int      @default(1)
  purpose         String?
  vehicleNumber   String?
  visitTime       String?
  visitDate       String?
  status          GatepassStatus @default(PENDING)
  residentId      String   // ID of resident who created it
  residentName    String?
  residentUnit    String?
  approvedAt      DateTime?
  approvedBy      String?  // security member id
  createdAt       DateTime @default(now())

  @@map("gatepasses")
}

enum GatepassStatus {
  PENDING
  APPROVED
  CANCELLED
  EXPIRED
}

// ─── Enums ───────────────────────────────────────────────────
enum MemberRole {
  APARTMENT_ADMIN
  RESIDENT
  CLEANING_STAFF
  CARETAKER
  SECURITY_STAFF
  ACCOUNTS_STAFF
  MAINTENANCE_STAFF
  ADMIN_STAFF
  STAFF
  SERVICE_STAFF
  ACCOUNTS
  MANAGER_STAFF
  MEMBER
  NOT_APPLICABLE
}

enum DepartmentType {
  RESIDENTS
  CLEANING
  CARETAKERS
  SECURITY
  ACCOUNTS
  MAINTENANCE
  MANAGEMENT
  NOT_APPLICABLE
}

enum NotificationType {
  NOTICE
  COMPLAINT_UPDATE
  VISITOR_ARRIVED
  PAYMENT_REMINDER
  POLL
  CHAT
  GENERAL
  EVENT
}

// ─── Community Rules ──────────────────────────────────────────
model Rule {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String   @db.Text
  category    String?  // e.g. "Parking", "Pets", "Common Area"
  photoUrl    String?  // Optional illustrative photo (R2 key or full URL)
  audience    String[] @default([])  // ["MEMBERS"|"RESIDENTS"|"STAFF"]
  createdBy   String?  // member id of the admin who created it
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("rules")
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum VisitorStatus {
  PENDING
  APPROVED
  REJECTED
  ENTERED
  EXITED
}

enum OccupancyType {
  RESIDENT
  RENTAL
}

// ─── Amenities ────────────────────────────────────────────────────────────────
model Amenity {
  id                     String   @id @default(cuid())
  tenantId               String
  name                   String
  description            String?
  rules                  String?
  photoUrl               String?
  maxPersons             Int      @default(1)
  timeSlots              String[] // Array of time slots, e.g., ["09:00-10:00", "10:00-11:00"]
  availableDates         String[] // Array of available dates, e.g., ["2023-10-01", "2023-10-02"]
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Dynamic scheduling extensions
  scheduleType           String   @default("CUSTOM") // "WEEKLY", "MONTHLY", "CUSTOM"
  scheduleConfig         String?  // JSON serialized config
  allowRecurringBookings Boolean  @default(false)

  bookings       AmenityBooking[]

  @@index([tenantId])
  @@map("amenities")
}

model AmenityBooking {
  id              String   @id @default(cuid())
  tenantId        String
  amenityId       String
  memberId        String
  bookingDate     String   // YYYY-MM-DD
  timeSlot        String
  persons         Int      @default(1)
  status          String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdAt       DateTime @default(now())

  // Recurrence extensions
  isRecurring     Boolean  @default(false)
  recurringPeriod String?  // "WEEKLY", "MONTHLY"
  parentBookingId String?

  amenity     Amenity  @relation(fields: [amenityId], references: [id])
  member      Member   @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@map("amenity_bookings")
}

// ─── Community Finance Extension ───

model CommunityTransaction {
  id                String          @id @default(cuid())
  tenantId          String
  amount            Float
  type              TransactionType @default(EXPENSE) // INCOME or EXPENSE
  category          String          // "Maintenance", "Sinking Fund", "Staff Salary", "Electricity", "Events", "Repairs"
  date              DateTime        @default(now())
  description       String?
  paymentMethod     String          @default("CASH") // "CASH", "UPI", "CARD", "BANK_TRANSFER"
  billUrl           String?         // S3 key for invoice scan or payment receipt
  addedById         String          // Member ID of the admin who logged it
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  maintenanceBillId String?         @unique
  maintenanceBill   MaintenanceBill? @relation(fields: [maintenanceBillId], references: [id])

  @@index([tenantId])
  @@map("community_transactions")
}

// ─── Attendance ───────────────────────────────────────────────
model AttendanceConfig {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  latitude      Float
  longitude     Float
  radiusMeters  Int      @default(500)
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("attendance_configs")
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  tenantId      String
  memberId      String
  markedAt      DateTime @default(now())
  date          String   // YYYY-MM-DD (tenant-local for fast filtering / uniqueness)
  latitude      Float
  longitude     Float
  distanceMeters Float
  status        AttendanceStatus @default(PRESENT)
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, memberId, date])
  @@index([tenantId, date])
  @@index([tenantId, memberId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  OUT_OF_AREA
}

model MaintenanceConfig {
  id              String          @id @default(cuid())
  tenantId        String          @unique
  billingCycle    BillingCycle    @default(MONTHLY)
  calculationType CalculationType @default(FLAT_RATE)
  flatRateAmount  Float           @default(0)    // Used for FLAT_RATE calculation
  ratePerSqFt     Float           @default(0)    // Used for AREA_BASED calculation (e.g. $0.20 / sq.ft.)
  dueDateDay      Int             @default(10)   // Day of month when bills are due (1 to 28)
  penaltyType     PenaltyType     @default(NONE)
  penaltyAmount   Float           @default(0)    // Flat amount or percentage depending on penaltyType
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([tenantId])
  @@map("maintenance_configs")
}

model MaintenanceBill {
  id              String            @id @default(cuid())
  tenantId        String
  unitId          String
  unit            Unit              @relation(fields: [unitId], references: [id])
  month           Int               // 1-12
  year            Int
  baseAmount      Float             // Computed based on calculationType
  otherCharges    Float             @default(0)   // Sinking fund, security cess, parking, etc.
  penaltyAmount   Float             @default(0)   // Applied late fee penalty
  totalAmount     Float             // baseAmount + otherCharges + penaltyAmount
  amountPaid      Float?            // Amount the resident says they paid (may differ from totalAmount)
  status          BillStatus        @default(UNPAID)
  dueDate         DateTime
  paymentDate     DateTime?
  paymentMethod   String?
  receiptUrl      String?           // S3 receipt URL uploaded by resident/admin
  description     String?           // Note entered by resident during payment proof submission
  adminNote       String?           // Admin note shared with resident on approve/reject
  rejectionReason String?           // Legacy: reason if rejected (kept for backwards compatibility)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  transaction     CommunityTransaction?

  @@unique([unitId, month, year])
  @@index([tenantId])
  @@map("maintenance_bills")
}

// ─── Community Payment Splits ──────────────────────────────────
// Admin-created one-off charges (e.g. roof repair, festival fund) split across blocks/units/residents.
// Kept separate from MaintenanceBill so split inflows do NOT pollute monthly maintenance reports.
model PaymentSplit {
  id            String              @id @default(cuid())
  tenantId      String
  purpose       String              // e.g. "Roof repair", "Festival fund"
  description   String?             // Long-form context
  totalAmount   Float                // Pool amount (sum of all shares)
  splitMode     String              @default("EQUAL") // EQUAL | CUSTOM
  targetType    String              // ALL | BLOCKS | UNITS
  targetBlocks  String[]            @default([])
  targetUnits   String[]            @default([])
  dueDate       DateTime?
  status        String              @default("ACTIVE") // ACTIVE | CLOSED
  createdById   String?             // Admin Member id
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  shares        PaymentSplitShare[]

  @@index([tenantId])
  @@map("payment_splits")
}

model PaymentSplitShare {
  id              String       @id @default(cuid())
  tenantId        String
  splitId         String
  split           PaymentSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit         @relation(fields: [unitId], references: [id])
  amount          Float        // Per-unit share
  amountPaid      Float?       // Amount resident says they paid
  status          BillStatus   @default(UNPAID)
  paymentDate     DateTime?
  paymentMethod   String?
  receiptUrl      String?
  description     String?      // Resident note
  adminNote       String?      // Admin note shared with resident
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([splitId, unitId])
  @@index([tenantId])
  @@map("payment_split_shares")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum CalculationType {
  FLAT_RATE
  AREA_BASED
}

enum BillStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  OVERDUE
}

enum PenaltyType {
  NONE
  FLAT
  PERCENTAGE
}

model CommunityAsset {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  category       String    // e.g. MACHINERY, ELECTRONICS, INFRASTRUCTURE, FURNITURE, OTHER
  status         String    @default("ACTIVE") // ACTIVE, MAINTENANCE, BROKEN, REPLACED
  serialNumber   String?
  purchaseDate   DateTime?
  purchaseCost   Float?
  warrantyExpiry DateTime?
  location       String?   // e.g. Block A Basement, Clubhouse, Main Gate
  description    String?
  photoUrl       String?   // Cloudflare R2 uploaded link
  billUrl        String?   // Cloudflare R2 uploaded bill link
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@map("community_assets")
}

model Reminder {
  id             String    @id @default(cuid())
  tenantId       String
  title          String
  message        String
  imageUrl       String?   // Optional illustrative image (R2 URL)
  category       String    // e.g. MAINTENANCE, DUTY_ROSTER, EVENT, GENERAL
  targetType     String    // e.g. ALL, SPECIFIC_UNITS, STAFF_ROLE, SPECIFIC_MEMBERS
  targetRoles    String[]  // Targeted staff roles (e.g., ["SECURITY_STAFF", "MAINTENANCE_STAFF"])
  targetUnits    String[]  // Targeted unit IDs (e.g., ["block-A-unit-101"])
  targetMembers  String[]  // Targeted specific members/staff IDs (e.g., ["memberId1"])
  scheduledAt    DateTime? // Null means send instantly, otherwise future timestamp
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  sentAt         DateTime?
  recurrence     String    @default("ONCE") // ONCE, WEEKLY, MONTHLY
  recurrenceDetail Int?      // Day of week (0=Sunday to 6=Saturday) or Date of month (1 to 31)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@map("reminders")
}
