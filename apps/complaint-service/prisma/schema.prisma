// complaint-service Prisma schema (per-tenant DB)
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@resido/complaint-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

model Complaint {
  id            String          @id @default(cuid())
  tenantId      String?
  title         String
  description   String
  category      String?
  status        ComplaintStatus @default(OPEN)
  priority      Priority        @default(MEDIUM)
  memberId      String?
  assignedTo    String?         // caretaker member id
  mediaUrls     String[]        // S3 keys / photo URLs
  progressNotes Json?
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  comments    ComplaintComment[]

  @@map("complaints")
}

model ComplaintComment {
  id          String    @id @default(cuid())
  complaintId String
  memberId    String
  message     String
  createdAt   DateTime  @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id])

  @@map("complaint_comments")
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICAL
  CLEANING
  SECURITY
  CARPENTRY
  LIFT
  COMMON_AREA
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
