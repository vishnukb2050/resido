{
    "expo": {
        "name": "Resido",
        "slug": "resido-app",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/resido_logo.jpg",
        "scheme": "resido",
        "userInterfaceStyle": "automatic",
        "splash": {
            "image": "./assets/resido_logo.jpg",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            [
                "expo-notifications",
                {
                    "color": "#6366f1"
                }
            ]
        ],
        "android": {
            "package": "com.resido.app",
            "permissions": [
                "CAMERA",
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION",
                "READ_EXTERNAL_STORAGE",
                "WRITE_EXTERNAL_STORAGE",
                "RECEIVE_BOOT_COMPLETED",
                "VIBRATE"
            ]
        },
        "ios": {
            "supportsTablet": false,
            "bundleIdentifier": "com.resido.app",
            "infoPlist": {
                "NSCameraUsageDescription": "Resido uses your camera to upload profile photos, visitor photos and cleaning reports.",
                "NSPhotoLibraryUsageDescription": "Resido accesses photos to upload files and media."
            }
        },
        "extra": {
            "eas": {
                "projectId": "your-eas-project-id"
            },
            "apiUrl": "https://residoapp.com/api",
            "socketUrl": "https://residoapp.com",
            "mediaBaseUrl": "https://pub-b77673bc094543898e426855c275bb56.r2.dev"
        }
    }
}