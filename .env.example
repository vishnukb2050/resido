# Application
DOMAIN=resido.app
NODE_ENV=development
PORT=3000

# Database Variables
# ─── DATABASE (AWS RDS) ──────────────────────────────────────────
DB_WRITE_ENDPOINT=postgresql://USER:PASSWORD@RDS_HOST:5432/resido_master?schema=public
DB_READ_ENDPOINT=postgresql://USER:PASSWORD@RDS_HOST:5432/resido_master?schema=public

# Standard Prisma URLs using the endpoints
AUTH_DATABASE_URL=${DB_WRITE_ENDPOINT}
TENANT_DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/postgres?schema=public

# External Dependencies - MSG91 OTP
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# AWS S3 Storage Config
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=resido-storage

# JWT Auth
JWT_SECRET=super_secret_jwt_key_123
JWT_REFRESH_SECRET=super_secret_refresh_key_123
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# WebSockets / Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Notifications
WHATSAPP_API_KEY=
FIREBASE_SERVER_KEY=
