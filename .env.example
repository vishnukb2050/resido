# Application
DOMAIN=resido.app
NODE_ENV=development
PORT=3000

# Database Variables
# ─── DATABASE (AWS RDS) ──────────────────────────────────────────
DB_WRITE_ENDPOINT=postgresql://USER:PASSWORD@RDS_HOST:5432/resido_master?schema=public
DB_READ_ENDPOINT=postgresql://USER:PASSWORD@RDS_HOST:5432/resido_master?schema=public

# Standard Prisma URLs using the endpoints
AUTH_DATABASE_URL=${DB_WRITE_ENDPOINT}
TENANT_DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/postgres?schema=public

# ─── DB connection pooling (per PrismaClient) ────────────────────
# Prisma defaults each client pool to (cpus*2)+1 connections. With many ECS
# tasks (autoscaling) and several clients per service, that exhausts Postgres
# max_connections. These cap each client's pool so total connections stay
# bounded as tasks scale out. Pair with RDS Proxy / PgBouncer for true scale.
# Applied automatically by withDbPool() unless already present in the URL.
DB_CONNECTION_LIMIT=5
DB_POOL_TIMEOUT=15

# External Dependencies - MSG91 OTP
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# AWS S3 Storage Config
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=resido-storage

# JWT Auth (Must be rotated in production using a cryptographically secure 64-byte hex key)
JWT_SECRET=placeholder_change_me_to_a_secure_64_byte_hex_in_production
JWT_REFRESH_SECRET=placeholder_change_me_to_a_secure_64_byte_hex_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# Comma-separated list of allowed origins (e.g. https://admin.resido.app)
CORS_ORIGINS=

# Redis (ElastiCache in prod — TLS required on AWS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
# Optional single URL (ECS / BullMQ). Use rediss:// for TLS, e.g. rediss://:pass@host:6379
# REDIS_URL=redis://localhost:6379

# Notifications
WHATSAPP_API_KEY=
FIREBASE_SERVER_KEY=
# Stringified service-account key JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_JSON=
