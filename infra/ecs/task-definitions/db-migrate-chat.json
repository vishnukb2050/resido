{
    "family": "resido-${ENV}-db-migrate-chat",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "${TASK_EXECUTION_ROLE}",
    "taskRoleArn": "${TASK_ROLE}",
    "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
    "containerDefinitions": [
        {
            "name": "db-migrate-chat",
            "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/chat-service:${IMAGE_TAG}",
            "essential": true,
            "command": ["/bin/sh", "./prisma-deploy.sh"],
            "environment": [
                { "name": "NODE_ENV", "value": "production" }
            ],
            "secrets": [
                { "name": "CHAT_WRITE_URL", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/chat-write-url" },
                { "name": "RDS_WRITE_URL", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/rds-write-url" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${LOG_GROUP}",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "db-migrate-chat",
                    "awslogs-create-group": "true"
                }
            }
        }
    ]
}
