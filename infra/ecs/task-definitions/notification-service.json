{
    "family": "resido-${ENV}-notification-service",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "${TASK_EXECUTION_ROLE}",
    "taskRoleArn": "${TASK_ROLE}",
    "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
    "containerDefinitions": [
        {
            "name": "notification-service",
            "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/notification-service:${IMAGE_TAG}",
            "essential": true,
            "portMappings": [
                { "containerPort": 3005, "protocol": "tcp", "name": "http", "appProtocol": "http" }
            ],
            "environment": [
                { "name": "NODE_ENV", "value": "production" },
                { "name": "PORT", "value": "3005" },
                { "name": "RUN_PRISMA_PUSH", "value": "false" }
            ],
            "secrets": [
                { "name": "NOTIFICATION_WRITE_URL", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/notification-write-url" },
                { "name": "JWT_SECRET",             "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/jwt-secret"             },
                { "name": "FCM_SERVER_KEY",         "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/fcm-server-key"         }
            ],
            "healthCheck": {
                "command": ["CMD-SHELL", "wget -q --spider http://localhost:3005/health || exit 1"],
                "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 30
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${LOG_GROUP}",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "notification-service",
                    "awslogs-create-group": "true"
                }
            }
        }
    ]
}
