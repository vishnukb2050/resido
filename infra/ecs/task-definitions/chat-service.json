{
    "family": "resido-${ENV}-chat-service",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "${TASK_EXECUTION_ROLE}",
    "taskRoleArn": "${TASK_ROLE}",
    "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
    "containerDefinitions": [
        {
            "name": "chat-service",
            "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/chat-service:${IMAGE_TAG}",
            "essential": true,
            "portMappings": [
                { "containerPort": 3004, "protocol": "tcp", "name": "http", "appProtocol": "http" }
            ],
            "environment": [
                { "name": "NODE_ENV", "value": "production" },
                { "name": "PORT", "value": "3004" },
                { "name": "RUN_PRISMA_PUSH", "value": "false" },
                { "name": "AUTH_SERVICE_URL", "value": "http://auth-service.resido.local:3001" }
            ],
            "secrets": [
                { "name": "CHAT_WRITE_URL", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/chat-write-url" },
                { "name": "CHAT_READ_URL",  "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/chat-read-url"  },
                { "name": "JWT_SECRET",     "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/jwt-secret"     },
                { "name": "INTERNAL_SERVICE_SECRET", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/internal-service-secret" },
                { "name": "REDIS_HOST",     "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-host"     },
                { "name": "REDIS_PORT",     "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-port"     },
                { "name": "REDIS_PASSWORD", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-password" },
                { "name": "REDIS_TLS",      "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-tls"      },
                { "name": "REDIS_URL",      "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-url"      }
            ],
            "healthCheck": {
                "command": ["CMD-SHELL", "wget -q --spider http://localhost:3004/health || exit 1"],
                "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 30
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${LOG_GROUP}",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "chat-service",
                    "awslogs-create-group": "true"
                }
            }
        }
    ]
}
