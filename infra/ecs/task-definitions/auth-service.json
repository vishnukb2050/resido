{
    "family": "resido-${ENV}-auth-service",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "${TASK_EXECUTION_ROLE}",
    "taskRoleArn": "${TASK_ROLE}",
    "runtimePlatform": {
        "operatingSystemFamily": "LINUX",
        "cpuArchitecture": "X86_64"
    },
    "containerDefinitions": [
        {
            "name": "auth-service",
            "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/auth-service:${IMAGE_TAG}",
            "essential": true,
            "portMappings": [
                { "containerPort": 3001, "protocol": "tcp", "name": "http", "appProtocol": "http" }
            ],
            "environment": [
                { "name": "NODE_ENV", "value": "production" },
                { "name": "PORT", "value": "3001" },
                { "name": "RUN_PRISMA_PUSH", "value": "false" }
            ],
            "secrets": [
                { "name": "MASTER_WRITE_URL",       "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/master-write-url" },
                { "name": "MASTER_READ_URL",        "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/master-read-url" },
                { "name": "USER_WRITE_URL",         "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/user-write-url" },
                { "name": "USER_READ_URL",          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/user-read-url" },
                { "name": "CORE_WRITE_URL",         "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/core-write-url" },
                { "name": "CORE_READ_URL",          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/core-read-url" },
                { "name": "GEO_WRITE_URL",          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/geo-write-url" },
                { "name": "RDS_WRITE_URL",          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/rds-write-url" },
                { "name": "JWT_SECRET",             "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/jwt-secret" },
                { "name": "MSG91_API_KEY",          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/msg91-api-key" },
                { "name": "AWS_S3_ACCESS_KEY",      "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/aws-s3-access-key" },
                { "name": "AWS_S3_SECRET_KEY",      "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/aws-s3-secret-key" },
                { "name": "REDIS_HOST",           "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-host" },
                { "name": "REDIS_PORT",           "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-port" },
                { "name": "REDIS_PASSWORD",       "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-password" },
                { "name": "REDIS_TLS",            "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-tls" },
                { "name": "REDIS_URL",            "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/redis-url" }
            ],
            "healthCheck": {
                "command": ["CMD-SHELL", "wget -q --spider http://localhost:3001/health || exit 1"],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${LOG_GROUP}",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "auth-service",
                    "awslogs-create-group": "true"
                }
            }
        }
    ]
}
