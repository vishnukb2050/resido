{
    "family": "resido-${ENV}-api-gateway",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "${TASK_EXECUTION_ROLE}",
    "taskRoleArn": "${TASK_ROLE}",
    "runtimePlatform": {
        "operatingSystemFamily": "LINUX",
        "cpuArchitecture": "X86_64"
    },
    "containerDefinitions": [
        {
            "name": "api-gateway",
            "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/api-gateway:${IMAGE_TAG}",
            "essential": true,
            "portMappings": [
                { "containerPort": 3000, "protocol": "tcp", "name": "http", "appProtocol": "http" }
            ],
            "environment": [
                { "name": "NODE_ENV", "value": "production" },
                { "name": "PORT", "value": "3000" },
                { "name": "AUTH_SERVICE_URL",         "value": "http://auth-service.resido.local:3001" },
                { "name": "RESIDENT_SERVICE_URL",     "value": "http://resident-service.resido.local:3002" },
                { "name": "CHAT_SERVICE_URL",         "value": "http://chat-service.resido.local:3004" },
                { "name": "NOTIFICATION_SERVICE_URL", "value": "http://notification-service.resido.local:3005" },
                { "name": "VISITOR_SERVICE_URL",      "value": "http://visitor-service.resido.local:3006" },
                { "name": "FLAREDTHREAD_SERVICE_URL", "value": "http://flaredthread-service.resido.local:3008" },
                { "name": "BUSINESS_SERVICE_URL",     "value": "http://business-service.resido.local:3009" }
            ],
            "secrets": [
                { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:resido/${ENV}/jwt-secret" }
            ],
            "healthCheck": {
                "command": ["CMD-SHELL", "wget -q --spider http://localhost:3000/health || exit 1"],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 30
            },
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${LOG_GROUP}",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "api-gateway",
                    "awslogs-create-group": "true"
                }
            }
        }
    ]
}
