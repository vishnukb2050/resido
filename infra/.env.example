# Copy to infra/.env (gitignored). Or: cp ../.env .env
#
# Required: RDS URLs, Redis, JWT, R2, MSG91 — same keys as ECS Secrets Manager.
# See ../AWS_SECRETS.md and ../GITHUB_VARIABLES.md

NODE_ENV=development

# ─── Postgres (external RDS or local) ───────────────────────────────────────
RDS_WRITE_URL=postgresql://user:pass@host:5432
MASTER_WRITE_URL=postgresql://user:pass@host:5432/resido_master?schema=public
USER_WRITE_URL=postgresql://user:pass@host:5432/resido_users?schema=public
CORE_WRITE_URL=postgresql://user:pass@host:5432/resido_core?schema=public
GEO_WRITE_URL=postgresql://user:pass@host:5432/resido_geodata?schema=public
CHAT_WRITE_URL=postgresql://user:pass@host:5432/resido_chat?schema=public
AUTH_DATABASE_URL=${MASTER_WRITE_URL}
TENANT_DATABASE_URL=${CORE_WRITE_URL}

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── Auth / internal (docker-compose sets dev defaults if unset) ───────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
INTERNAL_SERVICE_SECRET=resido-internal-dev-secret
MEDIA_WORKER_SECRET=resido-media-dev-secret
RUN_PRISMA_PUSH=true

# ─── CORS / admin SPAs ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost
VITE_API_URL=http://localhost:3000

# ─── Third-party (see root .env) ───────────────────────────────────────────
# OTP_PROVIDER, MSG91_*, AWS_* (R2), CLOUDFLARE_R2_PUBLIC_URL, FIREBASE_*
